        {
          "listen": "test",
          "script": {
            "id": "352854e7-e2e9-44d2-a077-128fac3e8d31",
            "exec": [
              "// 1. Phân tích cú pháp phản hồi JSON từ API\r",
              "const responseData = pm.response.json();\r",
              "\r",
              "// 2. Trích xuất id của phần tử đầu tiên trong mảng content\r",
              "const firstNotificationId = responseData.data.page.content[0].id;\r",
              "\r",
              "// 3. Lưu giá trị vào biến Environment (Biến môi trường)\r",
              "pm.environment.set(\"notificationId\", firstNotificationId);\r",
              "\r",
              "// (Tùy chọn) In ra console để kiểm tra xem đã lấy đúng chưa\r",
              "console.log(\"Đã lưu notificationId: \" + firstNotificationId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "id": "2b9eb822-8d9b-4410-a001-7dfc9f4aad8b",
