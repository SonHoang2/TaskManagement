        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "49819ea0-54ed-4eaf-a2e1-19c001710ef4",
                "exec": [
                  "// 1. Phân tích cú pháp chuỗi JSON trả về từ API\r",
                  "const responseData = pm.response.json();\r",
                  "\r",
                  "// 2. Trích xuất projectId từ cấu trúc data.project.id\r",
                  "const projectId = responseData.data.project.id;\r",
                  "\r",
                  "// 3. Lưu vào biến môi trường (Khuyên dùng)\r",
                  "pm.environment.set(\"projectId\", projectId);\r",
                  "\r",
                  "// In ra console để bạn dễ dàng kiểm tra/debug nếu cần\r",
                  "console.log(\"Đã lưu projectId thành công:\", projectId);"
                ],
                "type": "text/javascript",
