            {
              "listen": "test",
              "script": {
                "id": "4c5ede04-d535-4987-9579-0b261a9d7b1c",
                "exec": [
                  "// 1. Parse dữ liệu JSON từ response trả về\r",
                  "const responseData = pm.response.json();\r",
                  "\r",
                  "// 2. Truy cập vào phần tử đầu tiên trong mảng \"projects\" và lấy \"id\"\r",
                  "const firstProjectId = responseData.data.projects[0].id;\r",
                  "\r",
                  "// 3. Lưu project id vào biến môi trường (Environment Variable) của Postman\r",
                  "pm.environment.set(\"projectId\", firstProjectId);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
