        {
          "name": "get all task",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "f619a62a-3344-425f-99dc-9e8c62702d61",
                "exec": [
                  "// 1. Phân tích cú pháp chuỗi JSON phản hồi từ API\r",
                  "const responseData = pm.response.json();\r",
                  "\r",
                  "// 2. Trích xuất id từ phần tử đầu tiên trong mảng content\r",
                  "const firstTaskId = responseData.data.page.content[0].id;\r",
                  "\r",
                  "// 3. Lưu giá trị id vào biến môi trường (Environment Variable) tên là 'taskId'\r",
                  "pm.environment.set(\"taskId\", firstTaskId);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
