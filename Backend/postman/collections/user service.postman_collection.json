    {
      "name": "Auth",
      "item": [
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "6d57e5be-3b04-442d-b06c-8132116e6f38",
                "exec": [
                  "// parse response JSON",
                  "const res = pm.response.json();",
                  "",
                  "// lấy các thông tin từ response",
                  "const token = res?.data?.auth?.accessToken;",
                  "const userId = res?.data?.auth?.userId;",
                  "",
                  "if (token) {",
                  "    // lưu vào environment variable",
                  "    pm.environment.set(\"accessToken\", token);",
                  "",
                  "    // optional: lưu luôn token type nếu cần",
                  "    const tokenType = res?.data?.auth?.tokenType || \"Bearer\";",
                  "    pm.environment.set(\"tokenType\", tokenType);",
                  "",
                  "    // lưu userId vào environment variable",
                  "    if (userId) {",
                  "        pm.environment.set(\"userId\", userId);",
                  "        console.log(\"User ID saved:\", userId);",
                  "    } else {",
                  "        console.warn(\"Không tìm thấy userId trong auth object\");",
                  "    }",
                  "",
                  "    console.log(\"Token saved:\", token);",
                  "} else {",
                  "    console.error(\"Không tìm thấy accessToken trong response\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
