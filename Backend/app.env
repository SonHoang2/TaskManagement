# Shared by every Spring Boot service in docker-compose (env_file). k8s equivalent: config in k8s/helm/taskmgmt/values.yaml.
# Small JVMs: one machine runs every service. Same flags as k8s, heap kept at the 25%-of-512M default.
JAVA_TOOL_OPTIONS=-XX:+UseSerialGC -Xms64m -Xmx128m -XX:TieredStopAtLevel=1 -XX:CICompilerCount=2 -Xss512k
# glibc otherwise opens up to 8 malloc arenas per core; each touched one stays resident
MALLOC_ARENA_MAX=2
# Tomcat keeps 10 idle workers per connector (app + actuator port); it still grows to 200 under load
SERVER_TOMCAT_THREADS_MIN_SPARE=2
# Env vars beat application*.properties, so this also overrides the DEBUG levels hard-coded there.
# DEBUG logs ~8 lines per request and cost ~30% throughput in load tests; switch one service to DEBUG when needed.
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_CLOUD_GATEWAY=INFO