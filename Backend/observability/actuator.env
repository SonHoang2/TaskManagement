# Shared by every Spring Boot service in docker-compose (env_file). k8s equivalent: k8s/00-config.yaml.
# Actuator on its own port: not exposed to users, not behind the app's security chain.
MANAGEMENT_SERVER_PORT=9090
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
# a few fixed _bucket series (not ~70 per URI) so Prometheus can histogram_quantile p95/p99 cheaply; 1s matches the latency alert
MANAGEMENT_METRICS_DISTRIBUTION_SLO_HTTP_SERVER_REQUESTS=50ms,100ms,250ms,500ms,1s,2500ms,5s
